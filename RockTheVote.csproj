<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>cs2_rockthevote</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The API project sits in a subfolder, so the default **/*.cs glob would compile its sources
         into this assembly on top of referencing them. That puts IMapListApi in two assemblies and
         the cross-plugin cast then fails, looking exactly like RockTheVote is not installed. -->
    <Compile Remove="RockTheVote.Api\**" />
    <None Remove="RockTheVote.Api\**" />
    <Compile Remove=".build\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Private=false: must resolve from addons/counterstrikesharp/shared/ so every plugin sees the
         same IMapListApi type. -->
    <ProjectReference Include="RockTheVote.Api\RockTheVote.Api.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- From nuget.org, copied next to the plugin by CopyPanoramaManager below: each
         CounterStrikeSharp plugin loads through a context that probes its own folder. Needs
         CounterStrikeSharp.API 1.0.374 or newer - the package declares it, and a lower pin fails
         restore with NU1605. -->
    <PackageReference Include="PanoramaManager" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.374" />
    <PackageReference Include="CS2MenuManager" Version="1.0.42" />
  </ItemGroup>

  <ItemGroup>
    <None Update="lang\**\*.*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Update="maplist.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="maplist.example.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup> 

  <!-- CopyLocalLockFileAssemblies is off and has to stay off: turning it on copies CounterStrikeSharp.API's
       whole dependency tree beside the plugin as well. This copies PanoramaManager's dll and nothing else. -->
  <Target Name="CopyPanoramaManager" AfterTargets="ResolveLockFileCopyLocalFiles">
    <ItemGroup>
      <ReferenceCopyLocalPaths Include="@(RuntimeCopyLocalItems)"
                               Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'PanoramaManager'" />
    </ItemGroup>
  </Target>

</Project>
